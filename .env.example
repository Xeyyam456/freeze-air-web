# Bunu .env.local adı ilə kopyala və dəyərləri doldur (.env.local GitHub-a getmir).
# Supabase paneli → Project Settings → API: "Project URL" və "Publishable key" (anon/publishable; gizli "service role" açarını BURAYA YAZMA).
NEXT_PUBLIC_SUPABASE_URL=https://roodclienblwrrlswmty.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Açıq saytın ünvanı (sitemap, robots, Open Graph). Canlıda real domen yaz.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin panelinin ünvanı (/api/revalidate üçün CORS). Canlıda real domen yaz.
ADMIN_ORIGIN=http://localhost:5173
